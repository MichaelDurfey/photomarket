# Server Configuration
NODE_ENV=development
PORT=3000
HTTPS_ENABLED=false
# Point to your key/cert files (keep the files outside the repo; backend/certs/ is gitignored)
SSL_KEY_PATH=./certs/localhost-key.pem
SSL_CERT_PATH=./certs/localhost-cert.pem
# Optional passphrase for encrypted keys
SSL_PASSPHRASE=

# JWT Secret (change this to a strong random string in production!)
SECRET_KEY=your_secret_key_change_this_in_production

# CORS origins (comma-separated). Defaults to localhost variants if unset.
# CORS_ORIGINS=https://your-domain.com,https://studio.apollographql.com

# Frontend URL (used for OAuth / OIDC callback redirect)
FRONTEND_URL=http://localhost:3001

# Shop customer login (OpenID Connect). Issuer URL must expose /.well-known/openid-configuration
# Examples: https://accounts.google.com  |  https://YOUR_TENANT.auth0.com/
OIDC_ISSUER=https://your-issuer.example.com
OIDC_CLIENT_ID=your_oidc_client_id
# Omit for public PKCE-only clients where the provider allows it
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/auth/oidc/callback
# Space-separated scopes (default openid profile email)
# OIDC_SCOPE=openid profile email

# Frontend Vite build: API origin when UI and API use different hosts/ports
# VITE_BACKEND_URL=http://localhost:3000

# Adobe Lightroom API Configuration
# Get these from https://developer.adobe.com/console
ADOBE_CLIENT_ID=your_adobe_client_id_here
ADOBE_CLIENT_SECRET=your_adobe_client_secret_here
ADOBE_REDIRECT_URI=http://localhost:3000/auth/adobe/callback

# GraphQL URL (for frontend SSR)
GRAPHQL_URL=http://localhost:3000/graphql

# Default album to display on the homepage (optional)
# DEFAULT_ALBUM_NAME=favorites

# Enable verbose API request logging
# DEBUG=true
